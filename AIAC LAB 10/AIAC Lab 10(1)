"""Calculate and display a student's average score."""


def calc_average(marks):
	# Indent the function body and loop so the code is valid Python.
	if not marks:
		raise ValueError("marks must contain at least one score")

	total = 0
	for mark in marks:
		total += mark

	average = total / len(marks)
	return average  # Fix the misspelled variable name: avrage -> average.


marks = [85, 90, 78, 92]
# Use regular Python quotes and close the print call.
print("Average Score is", calc_average(marks))
